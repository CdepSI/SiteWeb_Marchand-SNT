<quiz>

  <!-- QCM HTML - Activité 1 -->

  <question type="multichoice">
    <name>
      <text>QCM_HTML_01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[Quelle est la balise racine qui contient tout le contenu d'une page HTML ?]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[La balise &lt;html&gt; est la balise racine qui englobe tout le contenu de la page.]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<!DOCTYPE html>]]></text>
      <feedback format="html">
        <text><![CDATA[&lt;!DOCTYPE html&gt; est la déclaration de type de document, pas la balise racine.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<head>]]></text>
      <feedback format="html">
        <text><![CDATA[&lt;head&gt; contient les informations meta, pas tout le contenu.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<body>]]></text>
      <feedback format="html">
        <text><![CDATA[&lt;body&gt; contient le contenu visible, mais pas tout le document.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<html>]]></text>
      <feedback format="html">
        <text><![CDATA[Correct ! &lt;html&gt; est la balise racine.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<title>]]></text>
      <feedback format="html">
        <text><![CDATA[&lt;title&gt; définit le titre de la page dans l'onglet du navigateur.]]></text>
      </feedback>
    </answer>
  </question>

