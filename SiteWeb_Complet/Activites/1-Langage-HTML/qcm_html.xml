  <question type="multichoice">
    <name>
      <text>QCM_HTML_04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[Quelle est la syntaxe correcte pour insérer une image dans une page HTML ?]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[La balise &lt;img&gt; avec les attributs src et alt est la syntaxe correcte pour insérer une image.]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<image src="photo.jpg" alt="Description">]]></text>
      <feedback format="html">
        <text><![CDATA[&lt;image&gt; n'est pas une balise HTML valide.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<img href="photo.jpg" alt="Description">]]></text>
      <feedback format="html">
        <text><![CDATA[L'attribut pour l'URL de l'image est src, pas href.]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<img src="photo.jpg" alt="Description">]]></text>
      <feedback format="html">
        <text><![CDATA[Correct ! C'est la syntaxe standard pour insérer une image.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<picture src="photo.jpg" alt="Description">]]></text>
      <feedback format="html">
        <text><![CDATA[&lt;picture&gt; est utilisé pour des images responsives, pas pour une image simple.]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<photo src="photo.jpg" alt="Description">]]></text>
      <feedback format="html">
        <text><![CDATA[&lt;photo&gt; n'est pas une balise HTML valide.]]></text>
      </feedback>
    </answer>
  </question>

