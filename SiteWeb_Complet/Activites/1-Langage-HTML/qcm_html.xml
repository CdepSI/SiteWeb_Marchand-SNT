  <question type="multichoice">
    <name>
      <text>QCM_HTML_04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Quelle est la syntaxe correcte pour insérer une image dans une page HTML ?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>La balise <code>&lt;img&gt;</code> avec les attributs src et alt est la syntaxe correcte pour insérer une image.</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>&lt;image src="photo.jpg" alt="Description"&gt;</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>&lt;image&gt; n'est pas une balise HTML valide.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>&lt;img href="photo.jpg" alt="Description"&gt;</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>L'attribut pour l'URL de l'image est src, pas href.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>&lt;img src="photo.jpg" alt="Description"&gt;</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Correct ! C'est la syntaxe standard pour insérer une image.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>&lt;picture src="photo.jpg" alt="Description"&gt;</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>&lt;picture&gt; est utilisé pour des images responsives, pas pour une image simple.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>&lt;photo src="photo.jpg" alt="Description"&gt;</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>&lt;photo&gt; n'est pas une balise HTML valide.</p>]]></text>
      </feedback>
    </answer>
  </question>

  <question type="multichoice">
    <name>
      <text>QCM_HTML_05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Quelle déclaration doit toujours être la première ligne d'un document HTML5 ?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p><code>&lt;!DOCTYPE html&gt;</code> est la déclaration obligatoire en première ligne d'un document HTML5.</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>&lt;html lang="fr"&gt;</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>&lt;html&gt; vient après la déclaration DOCTYPE.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>&lt;head&gt;</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>&lt;head&gt; vient après &lt;html&gt;.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>&lt;!DOCTYPE html&gt;</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Correct ! C'est la déclaration obligatoire en première ligne.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>&lt;body&gt;</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>&lt;body&gt; vient après &lt;head&gt;.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>&lt;title&gt;Ma page&lt;/title&gt;</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>&lt;title&gt; est contenu dans &lt;head&gt;.</p>]]></text>
      </feedback>
    </answer>
  </question>

</quiz>